# Copy this file to .env and provide your own OpenRouter credentials.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace-with-a-supported-model-id
OPENROUTER_TIMEOUT_SECONDS=30

# Optional metadata recommended by OpenRouter for application attribution.
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_APP_TITLE=Media Space Analytics